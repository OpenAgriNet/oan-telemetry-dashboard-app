# Copy to .env and adjust for your environment.
#
# IMPORTANT:
# - VITE_API_SERVER_URL  → telemetry dashboard API  (…/v1)
# - VITE_KEYCLOAK_URL    → Keycloak auth only       (…/auth)
# Do NOT use the auth host as the API base URL (causes CORS / 404).

VITE_API_SERVER_URL=https://dev-dashboard-vistaar.da.gov.in/v1

VITE_KEYCLOAK_URL=https://dev-auth-vistaar.da.gov.in/auth
VITE_KEYCLOAK_REALM=bharat-vistaar
VITE_KEYCLOAK_CLIENT_ID=bharat-vistaar

# Optional: Watchtower status API
# VITE_WATCHTOWER_BASE_URL=https://dev-dashboard-vistaar.da.gov.in/api
# VITE_WATCHTOWER_JWT=
